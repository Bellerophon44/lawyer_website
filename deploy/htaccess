# Déployé en tant que /sites/schumpf-avocat.com/.htaccess par tools/build.mjs
#
# Ce fichier ÉCRASE celui du serveur à chaque déploiement. Toute règle ajoutée
# à la main côté Infomaniak doit donc être reportée ici, sinon elle est perdue
# au déploiement suivant.
#
# Les deux premières sections proviennent du .htaccess généré par Infomaniak,
# relevé sur le serveur avant la première mise en production. Elles sont
# conservées telles quelles.
#
# SSL — état vérifié le 18/08/2026 depuis le serveur :
#   curl -I https://schumpf-avocat.com      ->  HTTP/2 200
#   curl -I https://www.schumpf-avocat.com  ->  HTTP/2 200
# Aucune erreur de certificat sur l'une ni l'autre variante, et le serveur
# renvoie deja strict-transport-security (HSTS actif). Le prerequis pose par le
# guide de transfert (SSL valide sur les deux variantes avant d'activer la
# redirection) est donc satisfait : les regles ci-dessous peuvent etre
# deployees telles quelles.
#
# A savoir si le certificat devait un jour ne plus couvrir www : aucune regle
# Apache ne pourrait le rattraper, la poignee de main TLS precedant la lecture
# de ce fichier. Cela releverait du certificat dans le Manager.

# --- Compression (configuration Infomaniak d'origine) ---------------------
SetOutputFilter DEFLATE
AddOutputFilterByType DEFLATE "application/atom+xml" "application/javascript" "application/json" "application/ld+json" "application/manifest+json" "application/rdf+xml" "application/rss+xml" "application/schema+json" "application/vnd.geo+json" "application/vnd.ms-fontobject" "application/x-font-ttf" "application/x-javascript" "application/x-web-app-manifest+json" "application/xhtml+xml" "application/xml" "font/eot" "font/opentype" "image/bmp" "image/svg+xml" "image/vnd.microsoft.icon" "image/x-icon" "text/cache-manifest" "text/css" "text/html" "text/javascript" "text/plain" "text/vcard" "text/vnd.rim.location.xloc" "text/vtt" "text/x-component" "text/x-cross-domain-policy" "text/xml"

# --- Protection des dossiers de versionnement (origine Infomaniak) --------
# SECTION BEGIN GIT PROTECTION
RedirectMatch 404 /\.git
# SECTION END GIT PROTECTION

# --- Page d'accueil -------------------------------------------------------
DirectoryIndex index.html

# --- Ne pas servir les sauvegardes laissées dans la racine du site --------
# Relevé le 18/08/2026 : https://schumpf-avocat.com/backup/ répondait 200, et
# ce dossier contenait une ancienne fiche avocate complète — page fantôme
# publiquement accessible et indexable, avec des liens morts.
#
# Ces fichiers doivent rester sur le serveur : index_old.html est le rollback
# décrit par le guide de transfert. Ils ne doivent simplement pas être servis.
# Un 404 est préférable à un 403, qui confirmerait leur existence.
#
# Ceci est une ceinture de sécurité, pas la solution : une sauvegarde n'a rien
# à faire dans la racine web. Cf. docs/hebergement-infomaniak.md.
RedirectMatch 404 ^/backup(/|$)
RedirectMatch 404 ^/index[-_](old|backup|new_pause|wix)

# Identifiants SMTP du formulaire (config/rdv.secrets.php) : jamais servis.
RedirectMatch 404 ^/config(/|$)

# --- Anciennes URL Wix, encore indexées par Google ------------------------
# Chiffres des 12 derniers mois Wix (data/analytics/) : /reserver-en-ligne
# était la 2e page la plus visitée (115 vues). Sans ces redirections, chaque
# clic depuis un ancien résultat Google tombe en 404.
# Placées AVANT la règle canonique : un seul saut, directement vers l'URL
# https finale.
RewriteEngine On
RewriteRule ^reserver-en-ligne/?$ https://schumpf-avocat.com/diagnostic.html [L,R=301]
RewriteRule ^droit-du-travail/?$ https://schumpf-avocat.com/expertises/droit-du-travail.html [L,R=301]
RewriteRule ^droit-penal-du-travail/?$ https://schumpf-avocat.com/expertises/droit-penal-du-travail.html [L,R=301]
RewriteRule ^droit-de-la-securite-sociale/?$ https://schumpf-avocat.com/expertises/securite-sociale-urssaf.html [L,R=301]

# --- Adresse canonique : https://schumpf-avocat.com (apex, sans www) ------
RewriteCond %{HTTPS} !=on [OR]
RewriteCond %{HTTP_HOST} ^www\.schumpf-avocat\.com$ [NC]
RewriteRule ^ https://schumpf-avocat.com%{REQUEST_URI} [L,R=301]

# --- Page 404 dans la charte du site --------------------------------------
ErrorDocument 404 /404.html

# --- En-têtes de sécurité, sans risque pour un site statique --------------
<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set X-Frame-Options "SAMEORIGIN"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# --- Cache : long sur les assets, nul sur le HTML -------------------------
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 7 days"
  ExpiresByType application/javascript "access plus 7 days"
  ExpiresByType image/jpeg "access plus 30 days"
  ExpiresByType image/png "access plus 30 days"
  ExpiresByType image/svg+xml "access plus 30 days"
  ExpiresByType text/html "access plus 0 seconds"
</IfModule>

# --- Ne pas exposer les fichiers de travail -------------------------------
<FilesMatch "\.(md|mjs|yml|yaml)$">
  Require all denied
</FilesMatch>
